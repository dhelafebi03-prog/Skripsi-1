# ----------------------------------------------------------
# 10. UJI KEKOKOHAN (M4-M7 pada 4 skenario)
# ----------------------------------------------------------
rob_fun <- function(m, label) {
  fm <- formula(m); fam <- family(m)
  skenario <- list(
    "Semua data" = dat,
    "Tanpa Jepara Feb 2023" =
      droplevels(subset(dat, !(kabupaten == "Jepara" & tahun == "2023" & bulan == 2))),
    "Hanya 2024-2025" = droplevels(subset(dat, tahun %in% c("2024", "2025"))),
    "Tanpa wilayah tanpa catatan" = droplevels(subset(dat, !(kabupaten %in% kab_nol)))
  )
  do.call(rbind, lapply(names(skenario), function(n) {
    mm <- tryCatch(glmmTMB(fm, family = fam, data = skenario[[n]]),
                   error = function(e) NULL)
    if (is.null(mm)) return(NULL)
    r <- irr(mm); r <- r[r$Variabel %in% var_cuaca, ]
    cbind(Model = label, Skenario = n, r)
  }))
}
rob <- rbind(rob_fun(M4, "M4"), rob_fun(M5, "M5 (+musim)"),
             rob_fun(M6, "M6 (+periode)"), rob_fun(M7, "M7 (+musim+periode)"))
cat("\n===== KEKOKOHAN HASIL =====\n"); print(tampil(rob), row.names = FALSE)
