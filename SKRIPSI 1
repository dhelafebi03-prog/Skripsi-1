# ----------------------------------------------------------
# 7. FREKUENSI OBSERVASI vs PREDIKSI
# ----------------------------------------------------------
frek <- function(m, tipe) {
  mu <- fitted(m)
  P <- sapply(0:4, function(k)
    if (tipe == "pois") sum(dpois(k, mu)) else sum(dnbinom(k, size = sigma(m), mu = mu)))
  c(P, nrow(dat) - sum(P))
}
obs <- c(sapply(0:4, function(k) sum(dat$y == k)), sum(dat$y >= 5))
fp <- rbind(Observasi = obs,
            Poisson = frek(M1, "pois"), NB = frek(M2, "nb"),
            Poisson_wilayah = frek(M3, "pois"), NB_wilayah = frek(M4, "nb"),
            NB_wilayah_musim = frek(M5, "nb"), NB_wilayah_periode = frek(M6, "nb"),
            NB_wilayah_periode_musim = frek(M7, "nb"))
colnames(fp) <- c("0", "1", "2", "3", "4", "5+")
cat("\n===== FREKUENSI OBSERVASI vs PREDIKSI =====\n"); print(round(fp, 1))
tulis(round(fp, 1), "frekuensi_obs_vs_prediksi.csv", row.names = TRUE)

