

# ============================================================
# 1. PERSIAPAN PERANGKAT LUNAK DAN PAKET
# ============================================================

library(pscl)
library(ggplot2)

setwd("C:/Users/ASUS/Downloads/DATA")
getwd()


# ============================================================
# 2. INPUT DATA
# ============================================================

data <- read.csv("Data Cuaca Ekstrem.csv",
  stringsAsFactors = FALSE,
  check.names = FALSE
)

names(data)
str(data)
head(data)


# ============================================================
# 3. PEMERIKSAAN NAMA VARIABEL
# ============================================================

variabel_wajib <- c(
  "kabupaten",
  "tahun",
  "bulan",
  "periode",
  "jumlah_kejadian",
  "curah_hujan",
  "suhu",
  "kec_angin"
)

if (!all(variabel_wajib %in% names(data))) {
  stop(
    "Nama kolom belum sesuai. Periksa kembali names(data)."
  )
}

cat("\nNama kolom berhasil diperiksa.\n")


# ============================================================
# 4. PEMERIKSAAN DAN PENGOLAHAN DATA
# ============================================================

variabel_numerik <- c(
  "jumlah_kejadian",
  "curah_hujan",
  "suhu",
  "kec_angin"
)

# Mengubah variabel numerik ke tipe numeric
for (v in variabel_numerik) {
  data[[v]] <- as.numeric(as.character(data[[v]]))
}

# Mengubah tahun dan bulan ke tipe integer
data$tahun <- as.integer(as.character(data$tahun))
data$bulan <- as.integer(as.character(data$bulan))

# Memeriksa nilai numerik yang tidak valid
if (any(!is.finite(
  as.matrix(data[, variabel_numerik])
))) {
  stop(
    "Ada nilai numerik yang tidak valid. Periksa data CSV."
  )
}

# Memeriksa nilai yang hilang
cat("\nJumlah missing value setiap variabel:\n")
print(colSums(is.na(data)))

# Memeriksa jumlah observasi awal
cat(
  "\nJumlah observasi awal:",
  nrow(data), "\n"
)

# Memeriksa duplikasi berdasarkan kabupaten, tahun, dan bulan
duplikat <- duplicated(
  data[c("kabupaten", "tahun", "bulan")]
)

cat(
  "Jumlah pengamatan duplikat:",
  sum(duplikat), "\n"
)

if (any(duplikat)) {
  stop(
    "Terdapat pengamatan duplikat berdasarkan kabupaten, tahun, dan bulan."
  )
}

# Menghapus baris dengan missing value pada variabel yang digunakan
data <- data[
  complete.cases(data[, variabel_wajib]),
]

cat(
  "Jumlah observasi setelah pemeriksaan:",
  nrow(data), "\n"
)

# Memastikan jumlah kejadian berupa bilangan bulat nonnegatif
if (
  any(data$jumlah_kejadian < 0) ||
  any(data$jumlah_kejadian != floor(data$jumlah_kejadian))
) {
  stop(
    "jumlah_kejadian harus berupa bilangan bulat nonnegatif."
  )
}

# Memeriksa nilai negatif pada curah hujan dan kecepatan angin
if (
  any(data$curah_hujan < 0) ||
  any(data$kec_angin < 0)
) {
  stop(
    "Periksa nilai negatif pada curah hujan atau kecepatan angin."
  )
}

# Memastikan bulan berada pada rentang 1 sampai 12
if (any(data$bulan < 1 | data$bulan > 12)) {
  stop("Nilai bulan harus berada pada rentang 1 sampai 12.")
}

# Memeriksa cakupan data
cat(
  "\nJumlah kabupaten/kota:",
  length(unique(data$kabupaten)), "\n"
)

cat(
  "Jumlah periode bulanan:",
  length(unique(data$periode)), "\n"
)

cat(
  "Jumlah observasi akhir:",
  nrow(data), "\n"
)

# Memeriksa apakah data mencakup 35 kabupaten/kota,
# 36 periode bulanan, dan 1.260 observasi
if (
  length(unique(data$kabupaten)) != 35 ||
  length(unique(data$periode)) != 36 ||
  nrow(data) != 1260
) {
  warning(
    "Cakupan data berbeda dari target 35 kabupaten/kota, ",
    "36 bulan, dan 1.260 observasi. Periksa kembali data."
  )
}


# ============================================================
# 5. ANALISIS STATISTIK DESKRIPTIF
# ============================================================

statistik_deskriptif <- data.frame(
  Variabel = variabel_numerik,
  Minimum = sapply(
    data[variabel_numerik], min
  ),
  Maksimum = sapply(
    data[variabel_numerik], max
  ),
  Rata_rata = sapply(
    data[variabel_numerik], mean
  ),
  Median = sapply(
    data[variabel_numerik], median
  ),
  Simpangan_baku = sapply(
    data[variabel_numerik], sd
  )
)

# Menampilkan hasil statistik deskriptif
print(statistik_deskriptif)

# Statistik ringkas tambahan
summary(data[variabel_numerik])

# Menyimpan statistik deskriptif
write.csv(
  statistik_deskriptif,
  "hasil_statistik_deskriptif.csv",
  row.names = FALSE
)


# ============================================================
# 6. PEMERIKSAAN PROPORSI NILAI NOL
# ============================================================

jumlah_nol <- sum(data$jumlah_kejadian == 0)
jumlah_positif <- sum(data$jumlah_kejadian > 0)
total_pengamatan <- nrow(data)

proporsi_nol <- jumlah_nol / total_pengamatan
proporsi_positif <- jumlah_positif / total_pengamatan

cat("\nJumlah nilai nol:", jumlah_nol, "\n")
cat("Jumlah nilai positif:", jumlah_positif, "\n")

cat(
  "Proporsi nilai nol:",
  round(proporsi_nol * 100, 2), "%\n"
)

cat(
  "Proporsi nilai positif:",
  round(proporsi_positif * 100, 2), "%\n"
)

# Membuat grafik distribusi jumlah kejadian
grafik_distribusi <- ggplot(
  data,
  aes(x = jumlah_kejadian)
) +
  geom_bar() +
  labs(
    title = "Distribusi Jumlah Kejadian Cuaca Ekstrem",
    x = "Jumlah Kejadian",
    y = "Frekuensi"
  ) +
  theme_minimal()

print(grafik_distribusi)

# Menyimpan grafik
ggsave(
  "grafik_distribusi_jumlah_kejadian.png",
  plot = grafik_distribusi,
  width = 8,
  height = 5,
  dpi = 300
)


# ============================================================
# 7. PEMERIKSAAN INDIKASI OVERDISPERSI
# ============================================================

# Model Poisson biasa sebagai pemeriksaan awal
model_poisson_awal <- glm(
  jumlah_kejadian ~
    curah_hujan +
    suhu +
    kec_angin,
  family = poisson(link = "log"),
  data = data
)

# Menghitung statistik Pearson
statistik_pearson <- sum(
  residuals(
    model_poisson_awal,
    type = "pearson"
  )^2
)

# Derajat bebas residual
derajat_bebas <- df.residual(model_poisson_awal)

# Rasio dispersi
rasio_dispersi <- statistik_pearson / derajat_bebas

cat(
  "\nStatistik Pearson:",
  round(statistik_pearson, 4), "\n"
)

cat(
  "Derajat bebas residual:",
  derajat_bebas, "\n"
)

cat(
  "Rasio dispersi:",
  round(rasio_dispersi, 4), "\n"
)

# Rasio dispersi yang jauh di atas 1 dapat mengindikasikan
# overdispersi. Ini merupakan pemeriksaan awal,
# bukan satu-satunya dasar pemilihan model.


# ============================================================
# 8. PEMODELAN REGRESI POISSON HURDLE
# ============================================================

# Bagian pertama:
# Model jumlah kejadian menggunakan distribusi Poisson
# yang telah dipotong pada nol (zero-truncated).

# Bagian kedua:
# Model peluang nol dibandingkan kejadian positif
# menggunakan distribusi binomial dengan link logit.

model_hurdle_poisson <- hurdle(
  jumlah_kejadian ~
    curah_hujan +
    suhu +
    kec_angin |
    curah_hujan +
    suhu +
    kec_angin,
  data = data,
  dist = "poisson",
  zero.dist = "binomial",
  link = "logit"
)

# Melihat hasil estimasi model Poisson Hurdle
summary(model_hurdle_poisson)


# ============================================================
# 9. PEMODELAN REGRESI HURDLE BINOMIAL NEGATIF
# ============================================================

# Bagian pertama menggunakan distribusi binomial negatif
# yang dipotong pada nol.

# Bagian kedua menggunakan distribusi binomial dengan
# link logit untuk membedakan nilai nol dan positif.

model_hurdle_negbin <- hurdle(
  jumlah_kejadian ~
    curah_hujan +
    suhu +
    kec_angin |
    curah_hujan +
    suhu +
    kec_angin,
  data = data,
  dist = "negbin",
  zero.dist = "binomial",
  link = "logit"
)

# Melihat hasil estimasi model Hurdle Binomial Negatif
summary(model_hurdle_negbin)


# ============================================================
# 10. PERBANDINGAN MODEL BERDASARKAN AIC
# ============================================================

aic_poisson <- AIC(model_hurdle_poisson)
aic_negbin <- AIC(model_hurdle_negbin)

hasil_aic <- data.frame(
  Model = c(
    "Poisson Hurdle",
    "Hurdle Binomial Negatif"
  ),
  AIC = c(
    aic_poisson,
    aic_negbin
  )
)

# Menampilkan perbandingan AIC
print(hasil_aic)

# Menentukan model dengan AIC lebih kecil
if (aic_poisson < aic_negbin) {
  
  model_terbaik <- model_hurdle_poisson
  nama_model_terbaik <- "Poisson Hurdle"
  
} else if (aic_negbin < aic_poisson) {
  
  model_terbaik <- model_hurdle_negbin
  nama_model_terbaik <- "Hurdle Binomial Negatif"
  
} else {
  
  model_terbaik <- NULL
  nama_model_terbaik <- "Kedua model memiliki AIC yang sama"
}

cat(
  "\nModel berdasarkan kriteria AIC:",
  nama_model_terbaik, "\n"
)

# Menampilkan ringkasan model terpilih
if (!is.null(model_terbaik)) {
  print(summary(model_terbaik))
}


# ============================================================
# 11. MENYIMPAN HASIL ANALISIS
# ============================================================

# Menyimpan hasil perbandingan AIC
write.csv(
  hasil_aic,
  "hasil_perbandingan_AIC.csv",
  row.names = FALSE
)

# Menyimpan objek dan hasil analisis
saveRDS(
  list(
    statistik_deskriptif = statistik_deskriptif,
    jumlah_nol = jumlah_nol,
    jumlah_positif = jumlah_positif,
    proporsi_nol = proporsi_nol,
    rasio_dispersi = rasio_dispersi,
    model_poisson_awal = model_poisson_awal,
    model_poisson_hurdle = model_hurdle_poisson,
    model_hurdle_negbin = model_hurdle_negbin,
    hasil_aic = hasil_aic,
    nama_model_terbaik = nama_model_terbaik
  ),
  file = "hasil_analisis_skripsi.rds"
)

cat("\nAnalisis selesai.\n")
cat("Hasil statistik deskriptif tersimpan.\n")
cat("Grafik distribusi jumlah kejadian tersimpan.\n")
cat("Hasil perbandingan AIC tersimpan.\n")
cat("Objek analisis tersimpan dalam hasil_analisis_skripsi.rds\n")

