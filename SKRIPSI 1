  "ZIP + efek wilayah"               = M8,
  "ZINB + efek wilayah"              = M9,
  "NB + wilayah + grid + musim"      = M10,
  "ZIP (tanpa efek wilayah)"         = ZIP,
  "ZINB (tanpa efek wilayah)"        = ZINB,
  "Hurdle Poisson (tanpa efek wil.)" = HP,
