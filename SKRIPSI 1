# ----------------------------------------------------------
dat <- read.csv("Data Cuaca Ekstrem.csv", stringsAsFactors = FALSE) %>%
  mutate(
    kode_kabupaten = sprintf("%.2f", kode_kabupaten),   
    kabupaten = factor(kabupaten),
    tahun     = factor(tahun),
    periode   = factor(periode),
    y         = jumlah_kejadian,
    hujan_c   = (curah_hujan - mean(curah_hujan)) / 100,  # per 100 mm
    suhu_c    = suhu - mean(suhu),                         # per 1 C
    angin_c   = kec_angin - mean(kec_angin),               # per 1 m/s
    musim     = case_when(
      bulan %in% c(11, 12, 1, 2, 3) ~ "Hujan",
      bulan %in% c(4, 5, 10)        ~ "Peralihan",
      TRUE                          ~ "Kemarau"
    ),
    musim = factor(musim, levels = c("Kemarau", "Peralihan", "Hujan"))
  )

# Pemeriksaan data: berhenti jika ada yang janggal
stopifnot(nrow(dat) == 1260, sum(dat$y) == 364, !anyNA(dat[, c("y", "curah_hujan", "suhu", "kec_angin")]))

sig <- dat %>%
  arrange(kabupaten, t) %>%
  group_by(kabupaten) %>%
  summarise(sig = paste(suhu, kec_angin, collapse = "|"), .groups = "drop")
sig$grid <- factor(as.integer(factor(sig$sig)))
dat <- left_join(dat, sig[, c("kabupaten", "grid")], by = "kabupaten")
cat("\nKabupaten/kota :", nlevels(dat$kabupaten),
    "\nSel grid unik  :", nlevels(dat$grid), "\n")
tulis(sig[, c("kabupaten", "grid")], "grid_cuaca_per_kabupaten.csv")

# Kabupaten/kota tanpa satu pun catatan kejadian
kab_nol <- dat %>% group_by(kabupaten) %>% summarise(total = sum(y), .groups = "drop") %>%
  filter(total == 0) %>% pull(kabupaten) %>% as.character()
cat("Tanpa catatan  :", paste(kab_nol, collapse = ", "), "\n")

f_dasar   <- y ~ hujan_c + suhu_c + angin_c + tahun
var_cuaca <- c("hujan_c", "suhu_c", "angin_c")

# ----------------------------------------------------------
# 2. MODEL (semua glmmTMB agar AIC sebanding)
# ----------------------------------------------------------
M1 <- glmmTMB(f_dasar, family = poisson, data = dat)    # Poisson
M2 <- glmmTMB(f_dasar, family = nbinom2, data = dat)    # Binomial Negatif
M3 <- glmmTMB(update(f_dasar, . ~ . + (1 | kabupaten)),
              family = poisson, data = dat)             # Poisson + wilayah
M4 <- glmmTMB(update(f_dasar, . ~ . + (1 | kabupaten)),
              family = nbinom2, data = dat)             # NB + wilayah
M5 <- glmmTMB(update(f_dasar, . ~ . + musim + (1 | kabupaten)),
              family = nbinom2, data = dat)             # M4 + musim (tetap)

# Efek acak periode: guncangan bersama pada bulan-tahun tertentu
M6 <- glmmTMB(update(f_dasar, . ~ . + (1 | kabupaten) + (1 | periode)),
              family = nbinom2, data = dat)
M7 <- glmmTMB(update(f_dasar, . ~ . + musim + (1 | kabupaten) + (1 | periode)),
              family = nbinom2, data = dat)

# Zero-inflated DENGAN efek wilayah (peluang nol struktural dibuat konstan)
M8 <- glmmTMB(update(f_dasar, . ~ . + (1 | kabupaten)),
              ziformula = ~ 1, family = poisson, data = dat)
M9 <- glmmTMB(update(f_dasar, . ~ . + (1 | kabupaten)),
              ziformula = ~ 1, family = nbinom2, data = dat)

# Sensitivitas sel grid: efek acak tambahan untuk sel grid NASA POWER
M10 <- tryCatch(
  glmmTMB(update(f_dasar, . ~ . + musim + (1 | kabupaten) + (1 | grid)),
          family = nbinom2, data = dat),
  error = function(e) { message("M10 (efek acak grid) gagal: ", conditionMessage(e)); NULL })

# Pembanding tanpa efek wilayah (rujukan saja)
fz   <- y ~ hujan_c + suhu_c + angin_c + tahun | hujan_c + suhu_c + angin_c + tahun
ZIP  <- zeroinfl(fz, data = dat, dist = "poisson")
ZINB <- zeroinfl(fz, data = dat, dist = "negbin")
HP   <- hurdle(fz, data = dat, dist = "poisson", zero.dist = "binomial")
HNB  <- hurdle(fz, data = dat, dist = "negbin",  zero.dist = "binomial")

