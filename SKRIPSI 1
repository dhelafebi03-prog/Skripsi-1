irr <- function(m) {
  s <- summary(m)$coefficients$cond
  data.frame(Variabel = rownames(s),
             IRR   = exp(s[, 1]),
             Bawah = exp(s[, 1] - 1.96 * s[, 2]),
             Atas  = exp(s[, 1] + 1.96 * s[, 2]),
             p     = s[, 4], row.names = NULL)
}
tampil <- function(r) transform(r, IRR = round(IRR, 3), Bawah = round(Bawah, 3),
                                Atas = round(Atas, 3), p = fmt_p(p))
tab_irr <- irr(M_akhir)
