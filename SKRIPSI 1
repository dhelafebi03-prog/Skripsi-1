tulis <- function(x, nama, row.names = FALSE) {
  x <- as.data.frame(x)
  x[] <- lapply(x, function(v) if (is.numeric(v)) round(v, 4) else v)
  write.csv2(x, file.path("hasil", nama), row.names = row.names)
}
# p-value dalam teks: nilai sangat kecil ditulis "<0,0001" (bukan 0 atau 3e-04)
fmt_p <- function(p) ifelse(p < 0.0001, "<0,0001",
                            formatC(p, format = "f", digits = 4, decimal.mark = ","))

