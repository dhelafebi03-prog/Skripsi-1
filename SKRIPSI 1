# ----------------------------------------------------------
# 4. UJI DISPERSI & NOL BERLEBIH (DHARMa)
# ----------------------------------------------------------
cek <- function(m, nama) {
  hit <- function(...) {
    s <- simulateResiduals(m, n = 500, seed = 123, ...)
    c(testDispersion(s, plot = FALSE)$p.value,
      testZeroInflation(s, plot = FALSE)$p.value)
  }
  kond <- hit()
  lama <- tryCatch(hit(simulateREs = "user-specified"), error = function(e) c(NA, NA))
  data.frame(Model = nama, p_dispersi_kond = kond[1], p_nol_kond = kond[2],
             p_dispersi_lama = lama[1], p_nol_lama = lama[2])
}
cek_tab <- rbind(
  cek(M1, "Poisson"), cek(M2, "Binomial Negatif"),
  cek(M3, "Poisson + efek wilayah"), cek(M4, "NB + efek wilayah"),
  cek(M5, "NB + efek wilayah + musim"), cek(M6, "NB + wilayah + periode"),
  cek(M7, "NB + wilayah + periode + musim"), cek(M9, "ZINB + efek wilayah")
)
identik <- all(abs(cek_tab$p_dispersi_kond - cek_tab$p_dispersi_lama) < 1e-6, na.rm = TRUE) &&
  all(abs(cek_tab$p_nol_kond - cek_tab$p_nol_lama) < 1e-6, na.rm = TRUE)
if (identik) {
  message("Kolom 'lama' identik dengan 'kond' -> dibuang (argumen tidak berpengaruh).")
  cek_tab <- cek_tab[, c("Model", "p_dispersi_kond", "p_nol_kond")]
}
cat("\n===== UJI DISPERSI & NOL =====\n"); print(cek_tab)
tulis(cek_tab, "uji_dispersi.csv")

